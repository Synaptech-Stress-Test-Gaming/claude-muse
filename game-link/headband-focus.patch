--- a/stacker.py
+++ b/stacker.py
@@ -3,16 +3,25 @@ Animal Stacker prototype (single file).
 
 Controls
     SPACE / left click  drop the hovering sprite (and replay on the game-over screen)
-    F (hold)            raise mock "focus" (stand-in for an EEG signal)
+    F (hold)            raise "focus" by keyboard (used when no headband is linked)
     R                   reset at any time
     ESC                 quit
 
+Headband focus
+    Open the Muse 2 control panel next to the game. Once its focus baselines are set,
+    the panel sends its 0-100 focus meter to this game and the game's focus follows it.
+    If the panel goes quiet for LINK_TIMEOUT seconds the F key takes over again.
+
 Requires: pygame, pymunk   (py -m pip install pygame pymunk)
 """
 
+import json
 import math
 import random
 import sys
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
 
 import pygame
 import pymunk
@@ -33,8 +42,12 @@ HOVER_MARGIN = 120              # how far past the platform edges the sprite swi
 SPEED_AT_ZERO_FOCUS = 900.0     # px / s
 SPEED_AT_FULL_FOCUS = 180.0     # px / s
 
-FOCUS_RISE = 0.6                # per second while F is held
-FOCUS_DECAY = 0.25              # per second otherwise
+FOCUS_RISE = 0.6                # per second while F is held / while following a higher headband reading
+FOCUS_DECAY = 0.25              # per second otherwise / while following a lower headband reading
+
+LINK_HOST = "127.0.0.1"         # only this computer can talk to the game
+LINK_PORT = 8765
+LINK_TIMEOUT = 2.0              # s without a headband reading before the F key takes over again
 
 REST_LIN_VEL = 4.0              # px / s, below this counts as "stopped"
 REST_ANG_VEL = 0.05             # rad / s
@@ -107,6 +120,77 @@ class Template:
         return body, shape
 
 
+# --- Headband link --------------------------------------------------------------
+class HeadbandLink:
+    """Receives the Muse 2 panel's focus meter over a tiny local-only web server.
+
+    The panel POSTs a small JSON body such as {"focus": 63.2} (0-100) about 4 times a
+    second, or {"focus": null} while its baselines are not set yet.
+    """
+
+    def __init__(self, host=LINK_HOST, port=LINK_PORT):
+        self.lock = threading.Lock()
+        self.value = None           # latest focus, 0-1, or None when the panel has none
+        self.stamp = 0.0            # time of the latest message
+        self.server = None
+        link = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def _reply(self, code=200, body=b'{"ok":true}'):
+                self.send_response(code)
+                self.send_header("Access-Control-Allow-Origin", "*")
+                self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
+                self.send_header("Access-Control-Allow-Headers", "Content-Type")
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def do_OPTIONS(self):
+                self._reply(204, b"")
+
+            def do_GET(self):
+                self._reply()
+
+            def do_POST(self):
+                try:
